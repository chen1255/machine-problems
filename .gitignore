# --- Backups created by the installer ---
*.bak
*.bak_*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
